# Krypton - environment template. Copy to `.env` (git-ignored) and fill in.
# Blank values are treated as "not set" (defaults apply to optional keys).

# --- Endpoints -------------------------------------------------------------
# Required. http:// or https:// JSON-RPC endpoint. Never commit URLs that embed API keys.
RPC_URL=https://api.mainnet-beta.solana.com
# Optional. ws:// or wss:// PubSub endpoint.
RPC_WS_URL=wss://api.mainnet-beta.solana.com
# Required. Jito Block Engine base URL (http:// or https://).
JITO_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# --- Wallet ----------------------------------------------------------------
# Required. Base58 keypair (64 bytes) OR a JSON byte array: [12,34,...].
PRIVATE_KEY=

# --- Commitment ------------------------------------------------------------
# processed | confirmed | finalized   (default: confirmed)
COMMITMENT=confirmed
# Commitment used for pre-flight simulation (default: processed)
PREFLIGHT_COMMITMENT=processed

# --- Execution parameters --------------------------------------------------
# Required. SOL spent by the creator on the initial buy, plain decimal (max 9 decimals).
CREATOR_SOL_AMOUNT=0.5
# Max price slippage in basis points, 0..=1000 (hard bound: 10%; default: 500 = 5%)
SLIPPAGE_BPS=500
# Compute unit limit, 1..=1400000 (default: 300000)
COMPUTE_UNIT_LIMIT=300000
# Priority fee in micro-lamports per compute unit (default: 100000)
PRIORITY_FEE_MICRO_LAMPORTS=100000
# Hard cap on the priority fee actually paid (price x COMPUTE_UNIT_LIMIT / 1e6), in lamports.
# Default 5000000 (0.005 SOL), absolute ceiling 50000000 (0.05 SOL). Startup fails above it.
# MAX_PRIORITY_FEE_LAMPORTS=5000000
# Jito tip in lamports, 1000..=MAX_JITO_TIP_LAMPORTS (default: 100000)
JITO_TIP_LAMPORTS=100000
# Hard cap on the Jito tip, in lamports. Default 1000000 (0.001 SOL), absolute ceiling
# 10000000 (0.01 SOL). Startup fails if JITO_TIP_LAMPORTS exceeds it.
# MAX_JITO_TIP_LAMPORTS=1000000
# true | false (default: true - safe by default, nothing is sent to the network)
DRY_RUN=true

# --- Live trading (Phase 7) ---------------------------------------------------
# Every switch below must be set deliberately, together with DRY_RUN=false, or the
# live executor refuses to start (the dry-run harness is unaffected). Leave all of
# them commented out unless you intend to spend real funds.
# LIVE_TRADING=true
# Must be exactly this phrase (anything else fails startup):
# LIVE_CONFIRM=I-UNDERSTAND-REAL-FUNDS-WILL-BE-SPENT
# Path of the keypair JSON file (chmod 600, regular file, not a symlink). Its public key
# must equal the PRIVATE_KEY wallet above.
# LIVE_KEYPAIR_PATH=/secure/path/live-keypair.json
# PAYER_KEYPAIR_PATH is an alias of LIVE_KEYPAIR_PATH (set one of them, or both with the
# same value). The `krypton` binary checks this file (owner-only, 0600) in every mode.
# PAYER_KEYPAIR_PATH=/secure/path/live-keypair.json
# Maximum SOL one transaction may spend, > 0 and <= 10 (required for live trading).
# MAX_SOL_PER_TX=0.5
# Maximum net SOL spent per UTC day, >= MAX_SOL_PER_TX and <= 50 (required for live trading).
# DAILY_DRAWDOWN_SOL=2

# --- Production bridge (the `krypton` binary) -------------------------------------
# All optional for dry runs of the library; `krypton exit` needs YELLOWSTONE_ENDPOINT and a
# build with the `grpc` feature (see docs/yellowstone-adapter.md).
# Going live ALSO needs the command line: `krypton exit ... --live --confirm-live <PHRASE>`.
#
# Yellowstone gRPC endpoint of the Geyser stream: https (plain http only for loopback).
# Providers often put an access token in the URL: treat it as a secret.
# YELLOWSTONE_ENDPOINT=https://your-provider.example.com:443
# Its `x-token`. Requires YELLOWSTONE_ENDPOINT; removed from the process environment at startup.
# YELLOWSTONE_X_TOKEN=
# Alias of JITO_ENGINE_URL (set one of them, or both with the same value).
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# HTTP tip-floor endpoint polled by the tip feed (NOT a WebSocket URL). Unset in live mode:
# the public https://bundles.jito.wtf/api/v1/bundles/tip_floor is used.
# JITO_TIP_STREAM_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor

# --- Logging ---------------------------------------------------------------
LOG_DIR=logs
# trace | debug | info | warn | error (default: info)
LOG_LEVEL=info

# --- IPFS / Pinata (Phase 2) -------------------------------------------------
# Required for metadata uploads. Pinata API key JWT (never commit it).
PINATA_JWT=
# Optional overrides. The upload host must be https (http only for loopback tests).
# PINATA_UPLOAD_URL=https://uploads.pinata.cloud
# Public gateway used to build image / metadata URIs (https, total URI <= 200 bytes).
# IPFS_GATEWAY_URL=https://ipfs.io/ipfs
# Per-request timeout in seconds, 1..=300 (default: 30)
# IPFS_TIMEOUT_SECS=30
# Retries after the first attempt, 0..=5 (default: 2)
# IPFS_MAX_RETRIES=2
